#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

WRAPPER=/etc/sctl/ramboot.sh
CONFIG=/etc/sctl/ramboot.conf
DISABLED=/etc/sctl/disabled
PID_FILE=/var/run/sctl.pid
LOG_FILE=/tmp/sctl/ramboot.log
EXTRA_COMMANDS="status"

validate_ramboot() {
    if [ -e "$DISABLED" ]; then
        echo "sctl: disabled by $DISABLED"
        return 1
    fi

    if [ ! -x "$WRAPPER" ]; then
        echo "sctl: missing executable wrapper $WRAPPER" >&2
        return 1
    fi
    if [ ! -r "$CONFIG" ]; then
        echo "sctl: missing ramboot config $CONFIG" >&2
        return 1
    fi
}

start_service() {
    validate_ramboot || return $?

    procd_open_instance
    procd_set_param command "$WRAPPER"
    procd_set_param respawn 10 30 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

start_legacy() {
    local pid
    validate_ramboot || return $?

    if [ -r "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "sctl: already running as pid $pid"
            return 0
        fi
    fi

    mkdir -p "$(dirname "$PID_FILE")" "$(dirname "$LOG_FILE")"
    "$WRAPPER" >>"$LOG_FILE" 2>&1 &
    echo "$!" > "$PID_FILE"
}

stop_legacy() {
    local pid
    [ -r "$PID_FILE" ] || return 0
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        sleep 1
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

status() {
    local pid
    if [ -r "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "running pid $pid"
            return 0
        fi
    fi
    echo "not running"
    return 1
}

start() {
    if type procd_open_instance >/dev/null 2>&1; then
        start_service "$@"
    else
        start_legacy "$@"
    fi
}

stop() {
    stop_legacy "$@"
}

reload_service() {
    stop
    start
}
