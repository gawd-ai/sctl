#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

WRAPPER=/etc/sctl/ramboot.sh
CONFIG=/etc/sctl/ramboot.conf
DISABLED=/etc/sctl/disabled
PID_FILE=/var/run/sctl.pid
SUP_PID_FILE=/var/run/sctl-supervisor.pid
LOG_FILE=/tmp/sctl/ramboot.log
RESPAWN_SECS=10
EXTRA_COMMANDS="status"

validate_ramboot() {
    if [ -e "$DISABLED" ]; then
        echo "sctl: disabled by $DISABLED"
        return 1
    fi

    if [ ! -x "$WRAPPER" ]; then
        echo "sctl: missing executable wrapper $WRAPPER" >&2
        return 1
    fi
    if [ ! -r "$CONFIG" ]; then
        echo "sctl: missing ramboot config $CONFIG" >&2
        return 1
    fi
}

start_service() {
    validate_ramboot || return $?

    procd_open_instance
    procd_set_param command "$WRAPPER"
    procd_set_param respawn 10 30 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

supervise_legacy() {
    # There is no procd on the RAM-boot underlay, so before this loop nothing
    # ever respawned a crashed daemon: one crash meant an unreachable vehicle
    # until its next ignition cycle. The wrapper execs sctl, so the pid
    # recorded each pass IS the daemon. The loop ends when `stop` kills the
    # supervisor, or on its own when $DISABLED exists at respawn time.
    local pid rc
    while :; do
        "$WRAPPER" >>"$LOG_FILE" 2>&1 &
        pid=$!
        echo "$pid" > "$PID_FILE"
        wait "$pid"
        rc=$?
        rm -f "$PID_FILE"
        if [ -e "$DISABLED" ]; then
            echo "sctl: disabled, supervisor exiting" >>"$LOG_FILE"
            break
        fi
        echo "sctl: daemon exited (rc=$rc), respawning in ${RESPAWN_SECS}s" >>"$LOG_FILE"
        sleep "$RESPAWN_SECS"
    done
    rm -f "$SUP_PID_FILE"
}

start_legacy() {
    local pid
    validate_ramboot || return $?

    if [ -r "$SUP_PID_FILE" ]; then
        pid=$(cat "$SUP_PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "sctl: supervisor already running as pid $pid"
            return 0
        fi
    fi
    # A pre-supervisor install may have left a bare daemon behind.
    if [ -r "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "sctl: already running as pid $pid (unsupervised)"
            return 0
        fi
    fi

    mkdir -p "$(dirname "$PID_FILE")" "$(dirname "$LOG_FILE")"
    supervise_legacy &
    echo "$!" > "$SUP_PID_FILE"
}

stop_legacy() {
    local pid
    # Supervisor first, so killing the daemon below cannot race a respawn.
    if [ -r "$SUP_PID_FILE" ]; then
        pid=$(cat "$SUP_PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ]; then
            kill "$pid" 2>/dev/null || true
        fi
        rm -f "$SUP_PID_FILE"
    fi
    [ -r "$PID_FILE" ] || return 0
    pid=$(cat "$PID_FILE" 2>/dev/null || true)
    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
        kill "$pid" 2>/dev/null || true
        sleep 1
        kill -9 "$pid" 2>/dev/null || true
    fi
    rm -f "$PID_FILE"
}

status() {
    local pid
    if [ -r "$PID_FILE" ]; then
        pid=$(cat "$PID_FILE" 2>/dev/null || true)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            echo "running pid $pid"
            return 0
        fi
    fi
    echo "not running"
    return 1
}

start() {
    if type procd_open_instance >/dev/null 2>&1; then
        start_service "$@"
    else
        start_legacy "$@"
    fi
}

stop() {
    stop_legacy "$@"
}

reload_service() {
    stop
    start
}
