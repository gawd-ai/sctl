[server]
listen = "0.0.0.0:1337"
data_dir = "/tmp/sctl/data"
# data_dir is tmpfs: an ignition cycle wipes it. The infra monitoring config,
# the infra credentials and the TLS pins go to flash instead (a few KB, written
# only when the fleet pushes or an operator trusts a certificate).
state_dir = "/etc/sctl/state"
journal_enabled = false
openwrt_persistent_logs = false
playbooks_dir = "/etc/sctl/playbooks"
max_connections = 6
max_sessions = 3
session_buffer_size = 200
max_file_size = 2097152
transfer_chunk_size = 65536

[auth]
api_key = "{{API_KEY}}"

[shell]
default_shell = "/bin/sh"
default_working_dir = "/tmp"

[device]
serial = "{{SERIAL}}"

[logging]
level = "warn"

# The out-of-band relay tunnel ([tunnel]) is per-deployment and is appended by
# install.sh, not templated here — either from TUNNEL_URL/TUNNEL_KEY, or by
# PRESERVING the block already on the device when those are not supplied.
# install.sh overwrites this whole file, so that preservation is what stops a
# re-install from silently changing how a unit that is only reachable over the
# tunnel routes it. Do not "simplify" it away.
#
# The block install.sh writes by default has no bind_address: it sets
# relay_route = "prefer" with relay_route_prefer = ["eth0", "usb0"], so sctl
# keeps the relay on the wire while the wire answers and falls back to LTE
# itself (the vendor dial script leaves LTE at metric 0, which is why
# "follow_default" is not used here). TUNNEL_BIND_ADDRESS still pins a unit
# that must stay on one uplink, and turns relay_route off.

[comms]
provider = "quectel-at"
library = "/tmp/sctl/lib/libsctl_comms_quectel.so"
# NO `device` hint — sctl DETECTS the Quectel AT port by USB interface :1.2. The
# ttyUSB number re-enumerates after a modem cycle; a hardcoded /dev/ttyUSBn opens
# the stale node at startup and takes the modem down. Detection self-heals.
startup_timeout_secs = 20
request_timeout_secs = 25

[lte]
# No `device` hint -> uses the detected comms port (see [comms]).
poll_interval_secs = 90
watchdog = false
interface = "{{LTE_INTERFACE}}"
