[server]
listen = "0.0.0.0:1337"
data_dir = "/tmp/sctl/data"
journal_enabled = false
openwrt_persistent_logs = false
playbooks_dir = "/etc/sctl/playbooks"
max_connections = 6
max_sessions = 3
session_buffer_size = 200
max_file_size = 2097152
transfer_chunk_size = 65536

[auth]
api_key = "{{API_KEY}}"

[shell]
default_shell = "/bin/sh"
default_working_dir = "/tmp"

[device]
serial = "{{SERIAL}}"

[logging]
level = "warn"

[comms]
provider = "quectel-at"
library = "/tmp/sctl/lib/libsctl_comms_quectel.so"
# NO `device` hint — sctl DETECTS the Quectel AT port by USB interface :1.2. The
# ttyUSB number re-enumerates after a modem cycle; a hardcoded /dev/ttyUSBn opens
# the stale node at startup and takes the modem down. Detection self-heals.
startup_timeout_secs = 20
request_timeout_secs = 25

[lte]
# No `device` hint -> uses the detected comms port (see [comms]).
poll_interval_secs = 90
watchdog = false
interface = "{{LTE_INTERFACE}}"
