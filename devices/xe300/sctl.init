#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PAYLOAD_DIR=/usr/local/lib/sctl
RUN_DIR=/tmp/sctl
BIN=$RUN_DIR/sctl-server
PLUGIN=$RUN_DIR/lib/libsctl_comms_quectel.so
CONFIG=/etc/sctl/sctl.toml
DISABLED=/etc/sctl/disabled
MIN_TMP_KB=16384

check_tmp_space() {
    local avail
    avail=$(df -k /tmp | awk 'NR==2 {print $4}')
    if [ -z "$avail" ] || [ "$avail" -lt "$MIN_TMP_KB" ]; then
        echo "sctl: not enough /tmp space: ${avail:-unknown} KB available, need $MIN_TMP_KB KB" >&2
        return 1
    fi
}

extract_payload() {
    local src="$1"
    local dst="$2"
    [ -r "$src" ] || { echo "sctl: missing payload $src" >&2; return 1; }
    gzip -dc "$src" > "$dst.tmp" || { rm -f "$dst.tmp"; return 1; }
    mv -f "$dst.tmp" "$dst"
}

start_service() {
    # Kill switch for field triage: `touch /etc/sctl/disabled` keeps the agent down
    # across reboots without uninstalling it or editing this script.
    [ -e "$DISABLED" ] && { echo "sctl: $DISABLED present, not starting" >&2; return 0; }
    [ -r "$CONFIG" ] || { echo "sctl: missing config $CONFIG" >&2; return 1; }
    check_tmp_space || return 1

    rm -rf "$RUN_DIR"
    mkdir -p "$RUN_DIR/lib"

    extract_payload "$PAYLOAD_DIR/sctl-server-mips_24kc.gz" "$BIN" || return 1
    extract_payload "$PAYLOAD_DIR/sctl-comms-quectel-mips_24kc.so.gz" "$PLUGIN" || return 1
    chmod 0755 "$BIN"
    chmod 0644 "$PLUGIN"

    # data_dir lives on the UBI overlay (see sctl.toml.template), NOT in RUN_DIR, so
    # connection history and the safe-mode flag survive the reboot that wipes tmpfs.
    mkdir -p /usr/local/lib/sctl/data

    procd_open_instance
    procd_set_param command "$BIN" serve --config "$CONFIG"
    procd_set_param respawn 5 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
