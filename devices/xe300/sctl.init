#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

PAYLOAD_DIR=/usr/local/lib/sctl
RUN_DIR=/tmp/sctl
BIN=$RUN_DIR/sctl-server
PLUGIN=$RUN_DIR/lib/libsctl_comms_quectel.so
SERVER_PAYLOAD=$PAYLOAD_DIR/sctl-server-mips_24kc.gz
PLUGIN_PAYLOAD=$PAYLOAD_DIR/sctl-comms-quectel-mips_24kc.so.gz
CONFIG=/etc/sctl/sctl.toml
DISABLED=/etc/sctl/disabled
MIN_TMP_KB=16384

check_tmp_space() {
    local avail
    avail=$(df -k /tmp | awk 'NR==2 {print $4}')
    if [ -z "$avail" ] || [ "$avail" -lt "$MIN_TMP_KB" ]; then
        echo "sctl: not enough /tmp space: ${avail:-unknown} KB available, need $MIN_TMP_KB KB" >&2
        return 1
    fi
}

extract_payload() {
    local src="$1"
    local dst="$2"
    [ -r "$src" ] || { echo "sctl: missing payload $src" >&2; return 1; }
    gzip -dc "$src" > "$dst.tmp" || { rm -f "$dst.tmp"; return 1; }
    mv -f "$dst.tmp" "$dst"
}

# What must hold before the agent is started. 0: it may start. 2: the kill
# switch says not to. 1: it cannot (the config, a payload, room in /tmp).
# `restart` asks before it stops the running agent, so a check that fails
# leaves the agent running instead of stopping one that would not start again.
start_checks() {
    # Kill switch for field triage: `touch /etc/sctl/disabled` keeps the agent down
    # across reboots without uninstalling it or editing this script.
    [ -e "$DISABLED" ] && { echo "sctl: $DISABLED present, not starting" >&2; return 2; }
    [ -r "$CONFIG" ] || { echo "sctl: missing config $CONFIG" >&2; return 1; }
    [ -r "$SERVER_PAYLOAD" ] || { echo "sctl: missing payload $SERVER_PAYLOAD" >&2; return 1; }
    [ -r "$PLUGIN_PAYLOAD" ] || { echo "sctl: missing payload $PLUGIN_PAYLOAD" >&2; return 1; }
    check_tmp_space || return 1
}

start_service() {
    start_checks
    case $? in
        0) ;;
        2) return 0 ;;
        *) return 1 ;;
    esac

    rm -rf "$RUN_DIR"
    mkdir -p "$RUN_DIR/lib"

    extract_payload "$SERVER_PAYLOAD" "$BIN" || return 1
    extract_payload "$PLUGIN_PAYLOAD" "$PLUGIN" || return 1
    chmod 0755 "$BIN"
    chmod 0644 "$PLUGIN"

    # data_dir lives on the UBI overlay (see sctl.toml.template), NOT in RUN_DIR, so
    # connection history and the safe-mode flag survive the reboot that wipes tmpfs.
    mkdir -p /usr/local/lib/sctl/data

    procd_open_instance
    procd_set_param command "$BIN" serve --config "$CONFIG"
    procd_set_param respawn 5 10 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

# rc.common leaves `restart` to the script. Its own is `stop` then `start`,
# which stops the agent before `start_service` has checked anything: with
# /tmp short of room, the agent was stopped and nothing started it again
# until the next boot. Ask first.
restart() {
    start_checks || {
        echo "sctl: not restarted: the running agent is left as it is" >&2
        return 1
    }
    trap '' TERM
    stop "$@"
    start "$@"
}
